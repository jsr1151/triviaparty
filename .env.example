# ── Local development (SQLite) ───────────────────────────────────────────────
# Default: uses a local SQLite file. No extra setup needed.
DATABASE_URL="file:./dev.db"

# ── Turso (hosted LibSQL) — recommended for Vercel / any server deployment ───
# Sign up free at https://turso.tech, then run:
#   turso db create triviaparty
#   turso db show triviaparty --url    → paste as DATABASE_URL below
#   turso db tokens create triviaparty → paste as TURSO_AUTH_TOKEN below
#
# DATABASE_URL="libsql://<db-name>-<org>.turso.io"
# TURSO_AUTH_TOKEN="<your-turso-auth-token>"

# ── Firebase (cross-device sync) ─────────────────────────────────────────────
# Create a free project at https://console.firebase.google.com
# Add a Web App, then copy the firebaseConfig values below.
# In Firestore, create a database in "test mode" (or set rules as needed).
#
# NEXT_PUBLIC_FIREBASE_API_KEY=""
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
# NEXT_PUBLIC_FIREBASE_APP_ID=""
